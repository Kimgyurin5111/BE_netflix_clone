# 이 파일을 application-local.yaml로 복사한 뒤 값을 채워서 사용하세요.
# application-local.yaml은 .gitignore에 등록되어 있어 커밋되지 않습니다.
spring:
  datasource:
    url: jdbc:mysql://localhost:3307/netflix_clone?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
    username: netflix
    password: netflix1234
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
